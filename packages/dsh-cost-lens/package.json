{
  "name": "dsh-cost-lens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Cost Lens — balance, usage, official peak/off-peak pricing and live spend in the DSH Web UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sagedeng/dsh-plugins.git",
    "directory": "dsh-cost-lens"
  },
  "homepage": "https://github.com/sagedeng/dsh-plugins/tree/main/packages/dsh-cost-lens#readme",
  "bugs": {
    "url": "https://github.com/sagedeng/dsh-plugins/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "pricing.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
