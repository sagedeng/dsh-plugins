{
  "$comment": "本机自建插件的唯一清单。换电脑时，代理按本文件逐条安装并验证。dir 相对仓库根；verify 是装完必须成立的事实。",
  "version": 1,
  "targetProfile": "desktop",
  "plugins": [
    {
      "id": "cost-lens",
      "package": "dsh-cost-lens",
      "dir": "packages/dsh-cost-lens",
      "version": "0.1.0",
      "enabled": true,
      "tarball": "dist/dsh-cost-lens-0.1.0.tgz",
      "configLayer": "profiles/desktop/cordis.patch.yml",
      "verify": {
        "configEntryId": "cost-lens",
        "route": "/dsh-cost-lens/state.json",
        "slot": {
          "name": "conversation.composer.dock",
          "id": "cost-lens"
        },
        "needs": [
          "python3 或 node 用于校验",
          "DeepSeek 账户登录或 DEEPSEEK_API_KEY（余额）"
        ]
      }
    },
    {
      "id": "github-ops",
      "package": "dsh-github-ops",
      "dir": "packages/dsh-github-ops",
      "version": "0.1.1",
      "enabled": true,
      "tarball": "dist/dsh-github-ops-0.1.1.tgz",
      "configLayer": "profiles/desktop/cordis.patch.yml",
      "verify": {
        "configEntryId": "github-ops",
        "tools": [
          "github_status",
          "github_pr_list",
          "github_pr_view",
          "github_checks",
          "github_issue_list",
          "github_repo_create",
          "github_commit_push",
          "github_pr_create",
          "github_pr_review",
          "github_issue_create"
        ],
        "needs": [
          "gh CLI 已安装且 gh auth login 完成",
          "approval 服务可用（写操作要审批）"
        ]
      }
    }
  ]
}
